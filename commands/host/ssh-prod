#!/usr/bin/env bash
#ddev-generated
#ddev-silent-no-warn

## Description: Ouvre une session SSH sur le serveur de production
## Usage: ssh-prod
## Example: ddev ssh-prod
## Flags: []
##
## Serveur lu dans le .env.local ou le .env du projet : PROD_USER, PROD_HOST
## (+ PROD_PORT, défaut 22).

set -euo pipefail

# Lit une variable dans un fichier .env sans le sourcer (pas d'exécution de code)
# — même helper que db-import/db-export (dupliqué : un _lib.sh partagé
# apparaîtrait comme commande dans `ddev -h`).
read_env_var() {
  local file="$1" key="$2" line value
  [ -f "$file" ] || return 1
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -n 1 || true)"
  [ -n "$line" ] || return 1

  value="${line#*=}"
  value="${value#"${value%%[![:space:]]*}"}"   # trim gauche

  if [ "${value:0:1}" = '"' ]; then
    value="${value#\"}"; value="${value%%\"*}"
  elif [ "${value:0:1}" = "'" ]; then
    value="${value#\'}"; value="${value%%\'*}"
  else
    value="${value%%#*}"                        # commentaire de fin de ligne
    value="${value%"${value##*[![:space:]]}"}"  # trim droite
  fi

  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# Première valeur trouvée dans le .env.local, puis dans le .env du projet. Le
# .env.local passe avant (convention Symfony : le .env peut être versionné, les
# valeurs locales vont dans .env.local).
read_project_var() {
  read_env_var "${DDEV_APPROOT}/.env.local" "$1" || read_env_var "${DDEV_APPROOT}/.env" "$1"
}

# Variables PROD_* : l'environnement prime, puis le .env.local et le .env.
for v in PROD_USER PROD_HOST PROD_PORT; do
  [ -n "${!v:-}" ] && continue
  if val="$(read_project_var "$v")"; then declare "$v=$val"; fi
done
PROD_PORT="${PROD_PORT:-22}"
for v in PROD_USER PROD_HOST; do
  [ -n "${!v:-}" ] || { echo "Erreur : $v manquant — définir les variables PROD_* dans le .env (ou .env.local) du projet." >&2; exit 1; }
done

exec ssh -p "$PROD_PORT" "${PROD_USER}@${PROD_HOST}"
