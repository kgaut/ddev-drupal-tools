#!/usr/bin/env bash
#ddev-generated
#ddev-silent-no-warn

## Description: Exporte la base dans files/dumps/<date>-<projet>-dev.sql.gz (Drupal : drush cr avant)
## Usage: db-export [--no-gzip] [-n] [--no-cr]
## Example: "ddev db-export" or "ddev db-export --no-gzip" or "ddev db-export -n" or "ddev db-export --no-cr"
## Flags: [{"Name":"no-gzip","Type":"bool","Usage":"Exporte en .sql non compressé"},{"Name":"dry-run","Shorthand":"n","Type":"bool","Usage":"Affiche ce qui serait fait, sans rien exécuter"},{"Name":"no-cr","Type":"bool","Usage":"Ne pas vider les caches avant l'export (Drupal)"}]
##
## Pendant de "ddev db-import". Les caches ne sont vidés (drush cr) que pour les
## projets Drupal (clé « type » du .ddev/config.yaml) : ce sont les seuls dont
## les caches sont en base.
##
## Le dossier de destination est "files/dumps" par défaut, surchargeable par
## projet via DB_DUMP_DIR dans le .env.local, le .env ou le .ddev/.env :
##   DB_DUMP_DIR=dumps
##   DB_DUMP_DIR=/chemin/absolu/vers/dumps

set -euo pipefail

DEFAULT_DUMP_DIR="files/dumps"
ENV_VAR_NAME="DB_DUMP_DIR"
SUFFIX="dev"

APPROOT="${DDEV_APPROOT:-$PWD}"
cd "$APPROOT"

gzip_it=true
dry_run=false
do_cr=true

while [ $# -gt 0 ]; do
  case "$1" in
    --no-gzip)    gzip_it=false ;;
    -n|--dry-run) dry_run=true ;;
    --no-cr)      do_cr=false ;;
    -*)           echo "Option inconnue : $1" >&2; exit 1 ;;
    *)            echo "Argument inattendu : $1" >&2; exit 1 ;;
  esac
  shift
done

# Vidage des caches : Drupal seulement, dont les caches sont en base (celui de
# Symfony, par exemple, est sur disque et n'alourdit pas le dump). Le type est
# la clé « type » du .ddev/config.yaml, transmise par DDEV.
case "${DDEV_PROJECT_TYPE:-}" in
  drupal|drupal[0-9]*) ;;
  *) do_cr=false ;;
esac

# Lit une variable dans un fichier .env sans le sourcer (pas d'exécution de code).
# Dupliqué depuis db-import pour garder chaque commande autonome.
read_env_var() {
  local file="$1" key="$2" line value
  [ -f "$file" ] || return 1
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -n 1 || true)"
  [ -n "$line" ] || return 1

  value="${line#*=}"
  value="${value#"${value%%[![:space:]]*}"}"   # trim gauche

  if [ "${value:0:1}" = '"' ]; then
    value="${value#\"}"; value="${value%%\"*}"
  elif [ "${value:0:1}" = "'" ]; then
    value="${value#\'}"; value="${value%%\'*}"
  else
    value="${value%%#*}"                        # commentaire de fin de ligne
    value="${value%"${value##*[![:space:]]}"}"  # trim droite
  fi

  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# Priorité : environnement > .env.local > .env (racine) > .ddev/.env > défaut.
# Le .env.local passe avant le .env (convention Symfony : le .env peut être
# versionné, les valeurs locales vont dans .env.local).
dump_dir="${!ENV_VAR_NAME:-}"
dump_dir_origin="variable d'environnement"
if [ -z "$dump_dir" ]; then
  if dump_dir="$(read_env_var "$APPROOT/.env.local" "$ENV_VAR_NAME")"; then
    dump_dir_origin=".env.local"
  elif dump_dir="$(read_env_var "$APPROOT/.env" "$ENV_VAR_NAME")"; then
    dump_dir_origin=".env"
  elif dump_dir="$(read_env_var "$APPROOT/.ddev/.env" "$ENV_VAR_NAME")"; then
    dump_dir_origin=".ddev/.env"
  else
    dump_dir="$DEFAULT_DUMP_DIR"
    dump_dir_origin="défaut"
  fi
fi

case "$dump_dir" in
  "~/"*) dump_dir="$HOME/${dump_dir#\~/}" ;;
esac
case "$dump_dir" in
  /*) ;;
  *) dump_dir="$APPROOT/$dump_dir" ;;
esac

sitename="${DDEV_SITENAME:-${DDEV_PROJECT:-db}}"
filename="$(date +%Y-%m-%d_%H-%M-%S)-${sitename}-${SUFFIX}.sql"
$gzip_it && filename="${filename}.gz"
target="$dump_dir/$filename"

echo "Projet     : ${DDEV_PROJECT:-?} (type ${DDEV_PROJECT_TYPE:-inconnu})"
echo "Dossier    : $dump_dir ($dump_dir_origin)"
echo "Fichier    : $filename"
echo "Actions    : $($do_cr && echo "drush cr, puis " || true)export de la base"
echo

if $dry_run; then
  echo "[dry-run] Commandes qui seraient exécutées :"
  $do_cr && echo "  ddev drush cr"
  echo "  ddev export-db --gzip=$($gzip_it && echo true || echo false) --file=$target"
  exit 0
fi

mkdir -p "$dump_dir"

if $do_cr; then
  echo "==> drush cr"
  ddev drush cr
fi

echo "==> Export de la base"
if $gzip_it; then
  ddev export-db --gzip=true --file="$target"
else
  ddev export-db --gzip=false --file="$target"
fi

echo
echo "Dump créé : $target ($(du -h "$target" | cut -f1))"
