#!/usr/bin/env bash
#ddev-generated

## Description: Télécharge en local le dernier dump de la base de production
## Usage: db-prod-get
## Example: ddev db-prod-get
## Flags: []
##
## Serveur/chemins lus dans le .env du projet : PROD_USER, PROD_HOST,
## PROD_PATH, PROD_DB_PATH (+ PROD_PORT, défaut 22). Un PROD_DB_PATH
## relatif est résolu depuis PROD_PATH, comme dans db-prod-dump.
## Destination locale :
## LOCAL_DB_PATH, sinon DB_DUMP_DIR (.env puis .ddev/.env — le dossier de dumps
## de db-import), sinon files/dumps.

set -euo pipefail

ENV_FILE="${DDEV_APPROOT}/.env"

# Lit une variable dans un fichier .env sans le sourcer (pas d'exécution de code)
# — même helper que db-import/db-export (dupliqué : un _lib.sh partagé
# apparaîtrait comme commande dans `ddev -h`).
read_env_var() {
  local file="$1" key="$2" line value
  [ -f "$file" ] || return 1
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -n 1 || true)"
  [ -n "$line" ] || return 1

  value="${line#*=}"
  value="${value#"${value%%[![:space:]]*}"}"   # trim gauche

  if [ "${value:0:1}" = '"' ]; then
    value="${value#\"}"; value="${value%%\"*}"
  elif [ "${value:0:1}" = "'" ]; then
    value="${value#\'}"; value="${value%%\'*}"
  else
    value="${value%%#*}"                        # commentaire de fin de ligne
    value="${value%"${value##*[![:space:]]}"}"  # trim droite
  fi

  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# Variables PROD_* : l'environnement prime, puis le .env du projet.
for v in PROD_USER PROD_HOST PROD_PORT PROD_PATH PROD_DB_PATH; do
  [ -n "${!v:-}" ] && continue
  if val="$(read_env_var "$ENV_FILE" "$v")"; then declare "$v=$val"; fi
done
PROD_PORT="${PROD_PORT:-22}"
for v in PROD_USER PROD_HOST PROD_PATH PROD_DB_PATH; do
  [ -n "${!v:-}" ] || { echo "Erreur : $v manquant — définir les variables PROD_* dans le .env du projet." >&2; exit 1; }
done

# Destination locale : LOCAL_DB_PATH > DB_DUMP_DIR (.env, .ddev/.env) > files/dumps.
LOCAL_DB_PATH="${LOCAL_DB_PATH:-}"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="$(read_env_var "$ENV_FILE" LOCAL_DB_PATH || true)"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="${DB_DUMP_DIR:-}"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="$(read_env_var "$ENV_FILE" DB_DUMP_DIR || true)"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="$(read_env_var "${DDEV_APPROOT}/.ddev/.env" DB_DUMP_DIR || true)"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="files/dumps"
case "$LOCAL_DB_PATH" in
  /*) DEST_DIR="$LOCAL_DB_PATH" ;;
  *)  DEST_DIR="${DDEV_APPROOT}/${LOCAL_DB_PATH}" ;;
esac

# Chemin distant : un PROD_DB_PATH relatif est résolu depuis
# PROD_PATH — même convention que db-prod-dump, qui écrit ses dumps
# après un « cd PROD_PATH ». Les chemins absolus et ceux en « ~ » sont
# laissés tels quels (développés par le shell distant).
case "${PROD_DB_PATH}" in
  /*|"~"|"~/"*) REMOTE_DB_DIR="${PROD_DB_PATH}" ;;
  *)            REMOTE_DB_DIR="${PROD_PATH}/${PROD_DB_PATH}" ;;
esac

DUMP="$(ssh -p "$PROD_PORT" "${PROD_USER}@${PROD_HOST}" "ls -t ${REMOTE_DB_DIR}/ | grep -E '[.]sql[.]gz$' | head -1")"
[ -n "$DUMP" ] || { echo "Erreur : aucun dump .sql.gz dans ${PROD_HOST}:${REMOTE_DB_DIR}/" >&2; exit 1; }

echo "Téléchargement du dump : ${REMOTE_DB_DIR}/${DUMP}"
mkdir -p "$DEST_DIR"
scp -P "$PROD_PORT" "${PROD_USER}@${PROD_HOST}:${REMOTE_DB_DIR}/${DUMP}" "$DEST_DIR/"
echo "Dump téléchargé : ${DEST_DIR}/${DUMP}"
