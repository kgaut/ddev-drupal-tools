#!/usr/bin/env bash
#ddev-generated
#ddev-silent-no-warn

## Description: Récupère en local un dump de la base de préproduction (dernier dump du serveur, ou mysqldump en direct)
## Usage: db-preprod-get
## Example: ddev db-preprod-get
## Flags: []
##
## Serveur lu dans le .env.local ou le .env du projet : PREPROD_USER, PREPROD_HOST
## (+ PREPROD_PORT, défaut 22). Deux modes :
## - PREPROD_DB_PATH (+ PREPROD_PATH) : rapatrie le dump le plus récent de ce dossier
##   du serveur (un chemin relatif est résolu depuis PREPROD_PATH, comme dans
##   db-preprod-dump), en affichant sa date et en avertissant s'il a plus de 24 h ;
## - PREPROD_DB_NAME, sans PREPROD_DB_PATH : fait un dump frais par mysqldump, envoyé
##   directement en local, sans fichier sur le serveur. Identifiants dans le
##   ~/.my.cnf du compte SSH ; nom du fichier d'après PREPROD_URL.
## Destination locale : LOCAL_DB_PATH, sinon DB_DUMP_DIR (.env.local, .env puis
## .ddev/.env — le dossier de dumps de db-import), sinon files/dumps.

set -euo pipefail

# Au-delà, le dump est signalé comme ancien (sans bloquer).
MAX_AGE_HOURS=24
# Options de mysqldump (mode PREPROD_DB_NAME) : --routines garde les procédures
# stockées, --single-transaction évite de verrouiller les tables InnoDB,
# --no-tablespaces se passe du droit PROCESS. Pas de --events : il exige le
# droit EVENT, et les tâches planifiées de preprod n'ont rien à faire en local.
MYSQLDUMP_OPTS="--single-transaction --quick --routines --triggers --no-tablespaces"

# Formatage d'un timestamp : « date » n'a pas les mêmes options en GNU (Linux)
# et en BSD (macOS) — même détection que db-import.
if stat -c '%Y' . >/dev/null 2>&1; then
  fmt_epoch() { date -d "@$1" '+%Y-%m-%d %H:%M'; }
else
  fmt_epoch() { date -r "$1" '+%Y-%m-%d %H:%M'; }
fi

# Durée lisible : « 42 min », « 5 h », « 18 j ».
fmt_age() {
  local s="$1"
  [ "$s" -ge 0 ] || s=0
  if [ "$s" -lt 3600 ]; then echo "$(( s / 60 )) min"
  elif [ "$s" -lt 86400 ]; then echo "$(( s / 3600 )) h"
  else echo "$(( s / 86400 )) j"
  fi
}

# Lit une variable dans un fichier .env sans le sourcer (pas d'exécution de code)
# — même helper que db-import/db-export (dupliqué : un _lib.sh partagé
# apparaîtrait comme commande dans `ddev -h`).
read_env_var() {
  local file="$1" key="$2" line value
  [ -f "$file" ] || return 1
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -n 1 || true)"
  [ -n "$line" ] || return 1

  value="${line#*=}"
  value="${value#"${value%%[![:space:]]*}"}"   # trim gauche

  if [ "${value:0:1}" = '"' ]; then
    value="${value#\"}"; value="${value%%\"*}"
  elif [ "${value:0:1}" = "'" ]; then
    value="${value#\'}"; value="${value%%\'*}"
  else
    value="${value%%#*}"                        # commentaire de fin de ligne
    value="${value%"${value##*[![:space:]]}"}"  # trim droite
  fi

  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# Première valeur trouvée dans le .env.local, puis dans le .env du projet. Le
# .env.local passe avant (convention Symfony : le .env peut être versionné, les
# valeurs locales vont dans .env.local).
read_project_var() {
  read_env_var "${DDEV_APPROOT}/.env.local" "$1" || read_env_var "${DDEV_APPROOT}/.env" "$1"
}

# Variables PREPROD_* : l'environnement prime, puis le .env.local et le .env.
for v in PREPROD_USER PREPROD_HOST PREPROD_PORT PREPROD_PATH PREPROD_DB_PATH PREPROD_DB_NAME PREPROD_URL; do
  [ -n "${!v:-}" ] && continue
  if val="$(read_project_var "$v")"; then declare "$v=$val"; fi
done
PREPROD_PORT="${PREPROD_PORT:-22}"
PREPROD_PATH="${PREPROD_PATH:-}"
PREPROD_DB_PATH="${PREPROD_DB_PATH:-}"
PREPROD_DB_NAME="${PREPROD_DB_NAME:-}"
missing() {
  echo "Erreur : $1 manquant — définir les variables PREPROD_* dans le .env (ou .env.local) du projet." >&2
  exit 1
}
for v in PREPROD_USER PREPROD_HOST; do
  [ -n "${!v:-}" ] || missing "$v"
done
# Mode : les dumps existants du serveur (PREPROD_DB_PATH) l'emportent ; sinon,
# dump frais par mysqldump (PREPROD_DB_NAME).
if [ -n "$PREPROD_DB_PATH" ]; then
  [ -n "$PREPROD_PATH" ] || missing PREPROD_PATH
elif [ -z "$PREPROD_DB_NAME" ]; then
  echo "Erreur : PREPROD_DB_PATH ou PREPROD_DB_NAME manquant — PREPROD_DB_PATH pour rapatrier les dumps du serveur, PREPROD_DB_NAME pour un dump mysqldump envoyé directement en local." >&2
  exit 1
fi

# Sans « / » final, pour des chemins assemblés et affichés proprement.
[ "$PREPROD_PATH" = / ] || PREPROD_PATH="${PREPROD_PATH%/}"
[ "$PREPROD_DB_PATH" = / ] || PREPROD_DB_PATH="${PREPROD_DB_PATH%/}"

# Destination locale : LOCAL_DB_PATH > DB_DUMP_DIR (.env.local, .env, .ddev/.env)
# > files/dumps.
LOCAL_DB_PATH="${LOCAL_DB_PATH:-}"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="$(read_project_var LOCAL_DB_PATH || true)"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="${DB_DUMP_DIR:-}"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="$(read_project_var DB_DUMP_DIR || true)"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="$(read_env_var "${DDEV_APPROOT}/.ddev/.env" DB_DUMP_DIR || true)"
[ -n "$LOCAL_DB_PATH" ] || LOCAL_DB_PATH="files/dumps"
case "$LOCAL_DB_PATH" in
  /*) DEST_DIR="$LOCAL_DB_PATH" ;;
  *)  DEST_DIR="${DDEV_APPROOT}/${LOCAL_DB_PATH}" ;;
esac

# Mode PREPROD_DB_NAME : mysqldump en flux, du serveur vers le dossier local.
if [ -z "$PREPROD_DB_PATH" ]; then
  name="$(date +%Y-%m-%d_%H-%M-%S)-${PREPROD_URL:-${DDEV_PROJECT:-db}}-preprod.sql.gz"
  target="${DEST_DIR}/${name}"
  # Le flux arrive dans un « .part », qu'ignore db-import : un dump interrompu
  # ne peut pas être importé par erreur. Supprimé en cas d'échec ou de Ctrl-C.
  part="${target}.part"
  mkdir -p "$DEST_DIR"
  trap 'rm -f "$part"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  echo "Dump de la base ${PREPROD_DB_NAME} (${PREPROD_HOST}) par mysqldump, directement en local…"
  # pipefail côté serveur quand le shell le connaît : testé dans un sous-shell,
  # un « set » refusé arrêterait un dash ancien.
  if ! ssh -p "$PREPROD_PORT" "${PREPROD_USER}@${PREPROD_HOST}" \
    "if (set -o pipefail) 2>/dev/null; then set -o pipefail; fi; nice -n 10 mysqldump ${MYSQLDUMP_OPTS} '${PREPROD_DB_NAME}' | nice -n 10 gzip" \
    > "$part"; then
    # MariaDB répond « Access denied » (1044) aussi pour une base inexistante.
    echo "Erreur : le dump a échoué sur ${PREPROD_HOST}. Vérifier PREPROD_DB_NAME (${PREPROD_DB_NAME} : base inexistante ou non autorisée ?) et les identifiants du ~/.my.cnf du compte SSH." >&2
    exit 1
  fi
  # Contrôles : archive intègre, et dernière ligne écrite par mysqldump en fin
  # de dump réussi.
  if ! gzip -t "$part" 2>/dev/null; then
    echo "Erreur : archive incomplète ou corrompue, dump supprimé." >&2
    exit 1
  fi
  last="$(gzip -dc "$part" | tail -n 1)"
  case "$last" in
    "-- Dump completed"*) ;;
    *) echo "Erreur : dump incomplet (dernière ligne : « ${last:0:80} »), dump supprimé." >&2; exit 1 ;;
  esac
  mv "$part" "$target"
  trap - EXIT INT TERM
  echo "Dump téléchargé : ${target} ($(du -h "$target" | cut -f1))"
  exit 0
fi

# Chemin distant : un PREPROD_DB_PATH relatif est résolu depuis
# PREPROD_PATH — même convention que db-preprod-dump, qui écrit ses dumps
# après un « cd PREPROD_PATH ». Les chemins absolus et ceux en « ~ » sont
# laissés tels quels (développés par le shell distant).
case "${PREPROD_DB_PATH}" in
  /*|"~"|"~/"*) REMOTE_DB_DIR="${PREPROD_DB_PATH}" ;;
  *)            REMOTE_DB_DIR="${PREPROD_PATH}/${PREPROD_DB_PATH}" ;;
esac

# Script distant : nom du dump le plus récent, puis son âge en secondes.
# L'âge est calculé par le serveur (pas de décalage d'horloge avec le poste
# local) ; « stat -c » est GNU, « stat -f » BSD. Le dossier arrive par
# l'affectation « d=… », où le shell distant développe un « ~ » de tête.
# Le « true » final garde le comportement historique : un dossier vide ou
# absent donne une sortie vide, signalée plus bas, pas un échec de ssh.
# shellcheck disable=SC2016  # les $… sont évalués par le shell distant
REMOTE_SCRIPT='f=$(ls -t "$d"/ | grep -E "[.]sql[.]gz\$" | head -1)
if [ -n "$f" ]; then
  echo "$f"
  m=$(stat -c %Y "$d/$f" 2>/dev/null || stat -f %m "$d/$f" 2>/dev/null) && echo $(( $(date +%s) - m ))
fi
true'
DUMP_INFO="$(ssh -p "$PREPROD_PORT" "${PREPROD_USER}@${PREPROD_HOST}" "d=${REMOTE_DB_DIR}
${REMOTE_SCRIPT}")"
DUMP="$(printf '%s\n' "$DUMP_INFO" | sed -n '1p')"
DUMP_AGE="$(printf '%s\n' "$DUMP_INFO" | sed -n '2p')"
[ -n "$DUMP" ] || { echo "Erreur : aucun dump .sql.gz dans ${PREPROD_HOST}:${REMOTE_DB_DIR}/" >&2; exit 1; }
[[ "$DUMP_AGE" =~ ^-?[0-9]+$ ]] || DUMP_AGE=""   # âge absent ou illisible

echo "Téléchargement du dump : ${REMOTE_DB_DIR}/${DUMP}"
if [ -n "$DUMP_AGE" ]; then
  echo "Date du dump : $(fmt_epoch "$(( $(date +%s) - DUMP_AGE ))") (il y a $(fmt_age "$DUMP_AGE"))"
else
  echo "Date du dump : inconnue (date de modification illisible sur le serveur)"
fi
# Pas de « scp -p » : le fichier local prend la date du téléchargement, ce qui
# en fait le plus récent du dossier, celui que db-import choisit ensuite dans
# db-preprod-import.
mkdir -p "$DEST_DIR"
scp -P "$PREPROD_PORT" "${PREPROD_USER}@${PREPROD_HOST}:${REMOTE_DB_DIR}/${DUMP}" "$DEST_DIR/"
echo "Dump téléchargé : ${DEST_DIR}/${DUMP}"

if [ -n "$DUMP_AGE" ] && [ "$DUMP_AGE" -gt $(( MAX_AGE_HOURS * 3600 )) ]; then
  echo "Attention : ce dump a plus de ${MAX_AGE_HOURS} h (il y a $(fmt_age "$DUMP_AGE"))." >&2
  echo "  Vérifier PREPROD_DB_PATH (${PREPROD_DB_PATH}), ou lancer d'abord « ddev db-preprod-dump »." >&2
fi
