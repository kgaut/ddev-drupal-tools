#!/usr/bin/env bash
#ddev-generated

## Description: Dump (gzip) de la base de production sur le serveur distant
## Usage: db-prod-dump
## Example: ddev db-prod-dump
## Flags: []
##
## Serveur/chemins lus dans le .env.local ou le .env du projet : PROD_USER,
## PROD_HOST, PROD_PATH, PROD_DRUSH, PROD_DB_PATH, PROD_URL (+ PROD_PORT, défaut 22).
## Un PROD_DB_PATH relatif est résolu depuis PROD_PATH.

set -euo pipefail

# Lit une variable dans un fichier .env sans le sourcer (pas d'exécution de code)
# — même helper que db-import/db-export (dupliqué : un _lib.sh partagé
# apparaîtrait comme commande dans `ddev -h`).
read_env_var() {
  local file="$1" key="$2" line value
  [ -f "$file" ] || return 1
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -n 1 || true)"
  [ -n "$line" ] || return 1

  value="${line#*=}"
  value="${value#"${value%%[![:space:]]*}"}"   # trim gauche

  if [ "${value:0:1}" = '"' ]; then
    value="${value#\"}"; value="${value%%\"*}"
  elif [ "${value:0:1}" = "'" ]; then
    value="${value#\'}"; value="${value%%\'*}"
  else
    value="${value%%#*}"                        # commentaire de fin de ligne
    value="${value%"${value##*[![:space:]]}"}"  # trim droite
  fi

  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# Première valeur trouvée dans le .env.local, puis dans le .env du projet. Le
# .env.local passe avant (convention Symfony : le .env peut être versionné, les
# valeurs locales vont dans .env.local).
read_project_var() {
  read_env_var "${DDEV_APPROOT}/.env.local" "$1" || read_env_var "${DDEV_APPROOT}/.env" "$1"
}

# Variables PROD_* : l'environnement prime, puis le .env.local et le .env.
for v in PROD_USER PROD_HOST PROD_PORT PROD_PATH PROD_DRUSH PROD_DB_PATH PROD_URL; do
  [ -n "${!v:-}" ] && continue
  if val="$(read_project_var "$v")"; then declare "$v=$val"; fi
done
PROD_PORT="${PROD_PORT:-22}"
for v in PROD_USER PROD_HOST PROD_PATH PROD_DRUSH PROD_DB_PATH PROD_URL; do
  [ -n "${!v:-}" ] || { echo "Erreur : $v manquant — définir les variables PROD_* dans le .env (ou .env.local) du projet." >&2; exit 1; }
done

# La redirection distante est entre guillemets (le nom du dump contient une
# date) : un « ~ » de tête n'y serait pas développé. On passe par $HOME, évalué
# par le shell du serveur.
remote_db_path="$PROD_DB_PATH"
case "$remote_db_path" in
  "~")   remote_db_path="\$HOME" ;;
  "~/"*) remote_db_path="\$HOME/${remote_db_path#\~/}" ;;
esac

echo "Dump de la base de production (${PROD_HOST})…"
ssh -t -p "$PROD_PORT" "${PROD_USER}@${PROD_HOST}" \
  "cd ${PROD_PATH} && ${PROD_DRUSH} sql-dump --gzip > \"${remote_db_path}/\$(date +%Y-%m-%d_%H-%M-%S)-${PROD_URL}-prod.sql.gz\""
echo "Dump terminé."
# Même « cd » que pour le dump : sans lui, un PROD_DB_PATH relatif serait
# cherché depuis le home SSH, et le ls échouerait après un dump réussi.
ssh -p "$PROD_PORT" "${PROD_USER}@${PROD_HOST}" "cd ${PROD_PATH} && ls -alh \"${remote_db_path}\""
