#!/usr/bin/env bash
#ddev-generated
#ddev-silent-no-warn

## Description: Dump (gzip) de la base de préproduction sur le serveur distant
## Usage: db-preprod-dump
## Example: ddev db-preprod-dump
## Flags: []
##
## Serveur/chemins lus dans le .env.local ou le .env du projet : PREPROD_USER,
## PREPROD_HOST, PREPROD_PATH, PREPROD_DRUSH, PREPROD_DB_PATH, PREPROD_URL (+ PREPROD_PORT, défaut 22).
## Un PREPROD_DB_PATH relatif est résolu depuis PREPROD_PATH. Passe par drush : réservé
## aux projets Drupal (sans drush : PREPROD_DB_NAME et db-preprod-get).

set -euo pipefail

# Lit une variable dans un fichier .env sans le sourcer (pas d'exécution de code)
# — même helper que db-import/db-export (dupliqué : un _lib.sh partagé
# apparaîtrait comme commande dans `ddev -h`).
read_env_var() {
  local file="$1" key="$2" line value
  [ -f "$file" ] || return 1
  line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$file" 2>/dev/null | tail -n 1 || true)"
  [ -n "$line" ] || return 1

  value="${line#*=}"
  value="${value#"${value%%[![:space:]]*}"}"   # trim gauche

  if [ "${value:0:1}" = '"' ]; then
    value="${value#\"}"; value="${value%%\"*}"
  elif [ "${value:0:1}" = "'" ]; then
    value="${value#\'}"; value="${value%%\'*}"
  else
    value="${value%%#*}"                        # commentaire de fin de ligne
    value="${value%"${value##*[![:space:]]}"}"  # trim droite
  fi

  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# Première valeur trouvée dans le .env.local, puis dans le .env du projet. Le
# .env.local passe avant (convention Symfony : le .env peut être versionné, les
# valeurs locales vont dans .env.local).
read_project_var() {
  read_env_var "${DDEV_APPROOT}/.env.local" "$1" || read_env_var "${DDEV_APPROOT}/.env" "$1"
}

# Variables PREPROD_* : l'environnement prime, puis le .env.local et le .env.
for v in PREPROD_USER PREPROD_HOST PREPROD_PORT PREPROD_PATH PREPROD_DRUSH PREPROD_DB_PATH PREPROD_URL PREPROD_DB_NAME; do
  [ -n "${!v:-}" ] && continue
  if val="$(read_project_var "$v")"; then declare "$v=$val"; fi
done
PREPROD_PORT="${PREPROD_PORT:-22}"
for v in PREPROD_USER PREPROD_HOST PREPROD_PATH PREPROD_DRUSH PREPROD_DB_PATH PREPROD_URL; do
  [ -n "${!v:-}" ] && continue
  # Sans drush, pas de dump sur le serveur : orienter vers ce qui existe.
  if [ "$v" = PREPROD_DRUSH ]; then
    if [ -n "${PREPROD_DB_NAME:-}" ]; then
      echo "Erreur : PREPROD_DRUSH manquant — db-preprod-dump passe par « drush sql-dump » sur le serveur. Avec PREPROD_DB_NAME, « ddev db-preprod-get » fait un dump mysqldump envoyé directement en local (et « ddev db-preprod-import » l'importe)." >&2
      exit 1
    fi
    case "${DDEV_PROJECT_TYPE:-}" in
      drupal|drupal[0-9]*) ;;
      *) echo "Erreur : PREPROD_DRUSH manquant — db-preprod-dump passe par « drush sql-dump », réservé aux projets Drupal (type DDEV de ce projet : ${DDEV_PROJECT_TYPE:-inconnu}). Pour un dump par mysqldump : définir PREPROD_DB_NAME et lancer « ddev db-preprod-get »." >&2; exit 1 ;;
    esac
  fi
  echo "Erreur : $v manquant — définir les variables PREPROD_* dans le .env (ou .env.local) du projet." >&2
  exit 1
done

# Sans « / » final, pour des chemins assemblés et affichés proprement.
[ "$PREPROD_PATH" = / ] || PREPROD_PATH="${PREPROD_PATH%/}"
[ "$PREPROD_DB_PATH" = / ] || PREPROD_DB_PATH="${PREPROD_DB_PATH%/}"

# La redirection distante est entre guillemets (le nom du dump contient une
# date) : un « ~ » de tête n'y serait pas développé. On passe par $HOME, évalué
# par le shell du serveur.
remote_db_path="$PREPROD_DB_PATH"
case "$remote_db_path" in
  "~")   remote_db_path="\$HOME" ;;
  "~/"*) remote_db_path="\$HOME/${remote_db_path#\~/}" ;;
esac

echo "Dump de la base de préproduction (${PREPROD_HOST})…"
ssh -t -p "$PREPROD_PORT" "${PREPROD_USER}@${PREPROD_HOST}" \
  "cd ${PREPROD_PATH} && ${PREPROD_DRUSH} sql-dump --gzip > \"${remote_db_path}/\$(date +%Y-%m-%d_%H-%M-%S)-${PREPROD_URL}-preprod.sql.gz\""
echo "Dump terminé."
# Même « cd » que pour le dump : sans lui, un PREPROD_DB_PATH relatif serait
# cherché depuis le home SSH, et le ls échouerait après un dump réussi.
ssh -p "$PREPROD_PORT" "${PREPROD_USER}@${PREPROD_HOST}" "cd ${PREPROD_PATH} && ls -alh \"${remote_db_path}\""
