#!/usr/bin/env bash
#ddev-generated
#ddev-silent-no-warn

## Description: Récupère un dump de préproduction (dernier dump du serveur, ou mysqldump en direct) puis l'importe en local
## Usage: db-preprod-import
## Example: ddev db-preprod-import
## Flags: []
##
## Enchaîne `ddev db-preprod-get` (dernier dump du serveur, ou dump mysqldump en
## direct, posé dans le dossier de dumps) puis `ddev db-import` (qui prend le
## dump le plus récent de ce dossier).

set -euo pipefail

ddev db-preprod-get
ddev db-import
